<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hubspot_deal_import_wizard_form" model="ir.ui.view">
        <field name="name">hubspot.deal.import.wizard.form</field>
        <field name="model">hubspot.deal.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import HubSpot Deals">
                <group>
                    <field name="import_type"/>
                </group>
                <footer>
                    <button name="action_confirm_import_deals"
                            string="Import"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>
