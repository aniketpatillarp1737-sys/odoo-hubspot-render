<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hubspot_productz_template_form" model="ir.ui.view">
        <field name="name">product_product_template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="after">
                <field name="hubspot_product_id"/>
                <field name="hubspot_instance_id"/>

            </xpath>
        </field>
    </record>

    <record id="product_template_search_hubspot_id_set" model="ir.ui.view">
        <field name="name">product.template.search.hubspot.id.set</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="hubspot_id_set"
                        string="HubSpot ID Set"
                        domain="[('hubspot_product_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>