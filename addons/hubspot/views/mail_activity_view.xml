<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hubspot_mail_activity_form" model="ir.ui.view">
            <field name="name">mail.activity.form.inherit</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='summary']" position="after">
                    <field name="hubspot_id"/>
                    <field name="hubspot_instance_id"/>

                </xpath>
            </field>
        </record>

        <record id="mail_activity_search_hubspot_id_set" model="ir.ui.view">
            <field name="name">mail.activity.search.hubspot.id.set</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter
                        name="hubspot_id_set"
                        string="HubSpot ID Set"
                        domain="[('hubspot_id', '!=', False)]"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>