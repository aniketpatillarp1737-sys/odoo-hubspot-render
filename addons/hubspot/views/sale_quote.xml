<?xml version="1.0" encoding="utf-8"?>
<odoo>
  
    <record id="hubspot_sale_template_form" model="ir.ui.view">
        <field name="name">sale.order2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="hubspot_sale_order_id"/>
                <field name="hubspot_instance_id"/>
                <field name="hubspot_quote_status"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_search_hubspot_id_set" model="ir.ui.view">
        <field name="name">sale.order.search.hubspot.id.set</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="hubspot_id_set"
                    string="HubSpot ID Set"
                    domain="[('hubspot_sale_order_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>




</odoo>