<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hubspot_mail_message_form" model="ir.ui.view">
        <field name="name">mail.activity.form.inherit</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="hubspot_id"/>
                <field name="hubspot_instance_id"/>
                <field name="hubspot_object"/>
            </xpath>
        </field>
    </record>

    <record id="mail_message_search_hubspot_id_set" model="ir.ui.view">
        <field name="name">mail.message.search.hubspot.id.set</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.view_message_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="hubspot_id_set"
                    string="HubSpot ID Set"
                    domain="[('hubspot_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>