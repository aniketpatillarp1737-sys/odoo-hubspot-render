<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_contact_queue_line_list" model="ir.ui.view">
        <field name="name">Contact.queue.line.list</field>
        <field name="model">contact.queue.line</field>
        <field eval="100" name="priority"/>
        <field name="arch" type="xml">
            <list create="false" duplicate="false" edit="false" sample="1" decoration-danger="state=='failed'"
                  decoration-success="state=='done'" decoration-info="state=='draft'">
                <field name="name"/>
                <field name="hubspot_contact_data_id"/>
                <field name="processed_last_date"/>
                <field name="hubspot_image_import_state"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_contact_queue_line_form"
            model="ir.ui.view">
        <field name="name">Contact.queue.line.form</field>
        <field name="model">contact.queue.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="hubspot_instance_id" readonly="1"/>
                            <field name="hubspot_contact_data_id" string="contact Data ID"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="contact_queue_id" readonly="1"/>
                            <field name="write_date" string="Last Updated On"
                                   readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact Data">
                            <group>
                                <field string="contact Data" name="hubspot_contact_data"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
