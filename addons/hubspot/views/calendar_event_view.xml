<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hubspot_calendar_event_form" model="ir.ui.view">
            <field name="name">hubspot.calendar.event.form.inherit</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location']" position="after">
                    <field name="hubspot_id"/>
                    <field name="hubspot_instance_id"/>
                </xpath>
            </field>
        </record>


        <record id="calendar_event_search_hubspot_id_set" model="ir.ui.view">
            <field name="name">calendar.event.search.hubspot.id.set</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter
                            name="hubspot_id_set"
                            string="HubSpot ID Set"
                            domain="[('hubspot_id', '!=', False)]"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>